#font-family = "Fira Code"
font-family = "JetBrainsMono NF"
theme = light:Catppuccin Latte,dark:Catppuccin Mocha
cursor-style = bar
font-size = 14
font-style = Bold
background-opacity = 0.80
background-blur-radius = 40
#background = 000000
#cursor-style = "block"
#shell-integration-features = no-cursor
#macos-titlebar-style = transparent
confirm-close-surface = false
split-divider-color = "dark green"
window-height = 40
window-width = 100
window-save-state = always
term = xterm-256color
auto-update-channel = tip
bell-features = system,title,attention,audio
macos-option-as-alt = true

# ---------------------------------------------------------------------------
# Ghostty's own keybinds
# ---------------------------------------------------------------------------
keybind = super+ctrl+t=prompt_surface_title

# Prompt fixes: send the control code instead of Ghostty's own action, so it
# reaches the pane rather than acting on the outer Ghostty surface.
#   ctrl+c  SIGINT
#   cmd+k   Ctrl-L, clears screen only (scrollback survives)
keybind = ctrl+c=text:\x03
keybind = cmd+k=text:\x0c

# ---------------------------------------------------------------------------
# Pass through to herdr (~/.config/herdr/config.toml [keys])
#
# `unbind` drops Ghostty's default action so the key is encoded and sent to the
# running app. Herdr reads it via the kitty keyboard protocol, e.g. cmd+t
# arrives as \x1b[116;9u (9 = 1+8 = super).
#
#   cmd+t          new_tab
#   cmd+w          close_pane
#   cmd+d          split_vertical
#   cmd+shift+d    split_horizontal
#   cmd+[ / ]      cycle_pane_previous / cycle_pane_next
#   cmd+shift+[ ]  previous_tab / next_tab
#   cmd+1..9       switch_workspace
#
# Not listed here, so no Ghostty binding is needed: alt+1..9 (switch_tab) and
# ctrl+b (prefix) have no Ghostty default to displace.
# ---------------------------------------------------------------------------
keybind = cmd+t=unbind
keybind = cmd+w=unbind
keybind = cmd+d=unbind
keybind = cmd+shift+d=unbind
keybind = cmd+[=unbind
keybind = cmd+]=unbind
keybind = cmd+shift+[=unbind
keybind = cmd+shift+]=unbind

# Digits need BOTH key names: Ghostty ships super+digit_N (physical) and
# super+N (logical), each bound to goto_tab. Missing either leaves the key
# dead, and `+list-keybinds | grep 'super\+[0-9]'` will not show digit_N.
keybind = cmd+digit_1=unbind
keybind = cmd+1=unbind
keybind = cmd+digit_2=unbind
keybind = cmd+2=unbind
keybind = cmd+digit_3=unbind
keybind = cmd+3=unbind
keybind = cmd+digit_4=unbind
keybind = cmd+4=unbind
keybind = cmd+digit_5=unbind
keybind = cmd+5=unbind
keybind = cmd+digit_6=unbind
keybind = cmd+6=unbind
keybind = cmd+digit_7=unbind
keybind = cmd+7=unbind
keybind = cmd+digit_8=unbind
keybind = cmd+8=unbind
keybind = cmd+digit_9=unbind
keybind = cmd+9=unbind
