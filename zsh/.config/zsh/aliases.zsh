alias zshc="nvim ~/.zshrc"
alias szh="source ~/.zshrc"

alias h="herdr"
alias cc="claude --dangerously-skip-permissions"
alias yolo="claude --dangerously-skip-permissions"
alias ct="claude --channels plugin:telegram@claude-plugins-official"

alias vi="nvim"
alias vim="nvim"
alias nvim="lazy"
